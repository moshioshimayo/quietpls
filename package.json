{
  "name": "quietpls",
  "version": "2.3.0",
  "description": "A floating macOS audio-level monitor for calls and meetings. Local-only, open source.",
  "main": "main.js",
  "bin": {
    "quietpls-mcp": "capture/mcp/server.js"
  },
  "scripts": {
    "build:native": "bash scripts/build-native.sh",
    "prestart": "bash scripts/build-native.sh",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predist": "bash scripts/build-native.sh",
    "dist": "electron-builder --mac",
    "release": "bash scripts/release.sh",
    "capture:test": "vitest run tests/unit/capture/",
    "capture:e2e": "playwright test tests/e2e/capture.spec.js",
    "capture:verify": "bash scripts/build-native.sh && vitest run tests/unit/capture/ && playwright test tests/e2e/capture.spec.js",
    "capture:mcp": "node capture/mcp/server.js",
    "capture:check-speakers": "node capture/check-speakers.js"
  },
  "keywords": [
    "voice",
    "monitor",
    "quiet",
    "audio",
    "electron",
    "macos"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "canvas": "^3.2.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.58.2",
    "vitest": "^3.2.4"
  }
}
